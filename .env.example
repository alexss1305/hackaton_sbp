# Copie este archivo a .env (o ejecute `npm run setup`, que lo crea con contraseñas aleatorias).
# .env NO se sube al repositorio.
PORT=3001
# Credenciales del personal de la Superintendencia (si falta el usuario se usa "analista" / "admin")
ANALISTA_USER=analista
ANALISTA_PASSWORD=
ADMIN_USER=admin
ADMIN_PASSWORD=
# Opcional: habilita el asistente de IA (explica resultados ya calculados; nunca calcula rankings).
GEMINI_API_KEY=
# Opcional: modelo de Gemini (por defecto gemini-flash-latest)
GEMINI_MODEL=
